DB_NAME=inventory
DB_USERNAME=inventory_user
DB_PASSWORD=inventory_pass
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# Three services, three ports. Cross-service calls use container hostnames
# inside compose (`http://inventory-service:8081`,
# `http://payment-service:8083`); running any service standalone from the
# host uses `http://localhost:8081` / `:8083`.
INVENTORY_SERVER_PORT=8081
BOOKING_SERVER_PORT=8082
PAYMENT_SERVER_PORT=8083
NOTIFICATION_SERVER_PORT=8084

# Payment failure-injection for Day 5 experiments (leave off for normal dev).
PAYMENT_SIMULATE_AUTH_FAILURE=false
PAYMENT_SIMULATE_CAPTURE_FAILURE=false
