DB_NAME=inventory
DB_USERNAME=inventory_user
DB_PASSWORD=inventory_pass
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# Two ports, two services. Booking calls inventory via
# INVENTORY_BASE_URL — inside compose, that's http://inventory-service:8081
# (see docker-compose.yml); running booking-service standalone against a
# host-side inventory would be INVENTORY_BASE_URL=http://localhost:8081.
INVENTORY_SERVER_PORT=8081
BOOKING_SERVER_PORT=8082
