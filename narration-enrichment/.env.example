GEMINI_API_KEY=AIza...

# --- P2 Day 4 (optional): S3 backing for raw policy docs -------------------
# Leave POLICY_S3_BUCKET empty to run without S3 (dev default). Setting
# it turns on durable raw-doc uploads in POST /policies/ingest; chunks
# + embeddings always live in SQLite regardless. Real bucket creation
# is Rajat's per AGENTS.md rule 3-2 (AWS work is user-driven).
POLICY_S3_BUCKET=
POLICY_S3_PREFIX=policy-docs/
AWS_REGION=ap-south-1
# boto3 also reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the
# environment or ~/.aws/credentials — do NOT put them in this file.
